{
  "appId": "com.rdp.gymkiosk.kiosk",
  "productName": "RDP-GYM",
  "files": [
    "main.js",
    "preload.js",
    "server.js",
    "index.html",
    "screensaver-tutorial.html",
    "package.json",
    "lib/**/*",
    "css/**/*",
    "js/**/*",
    "mobile/**/*",
    "data/**/*",
    "assets/**/*",
    "!assets/face-models/**/*",
    "!**/*-Rick’s MacBook Pro.js",
    "!**/*.bak",
    "!**/*.log"
  ],
  "directories": {
    "output": "../installs/dist-kiosk-installer",
    "buildResources": "assets"
  },
  "extraMetadata": {
    "main": "main.js"
  },
  "win": {
    "icon": "assets/branding/logo.png",
    "target": [
      "nsis"
    ],
    "artifactName": "RDP-GYM-v${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "RDP-GYM"
  }
}
