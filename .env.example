# GymKiosk environment settings
# Copy this file to .env and fill in real values.

# Core server
PORT=3001

# CORS allowlist (comma-separated)
# Keep localhost entries when testing locally.
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,https://gymkioskapp.onrender.com,https://www.rdpsstrengthandconditioning.ca

# API request throttling
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=240

# Launcher/kiosk recovery controls
GYMKIOSK_KEEP_SERVER_ON_KIOSK_CRASH=1
GYMKIOSK_RESTART_KIOSK_ON_CRASH=1
GYMKIOSK_KIOSK_RESTART_DELAY_MS=2000
GYMKIOSK_MAX_KIOSK_CRASH_RESTARTS=5
GYMKIOSK_KIOSK_STABLE_RESET_MS=60000
GYMKIOSK_KIOSK_HANDOFF_GRACE_MS=15000

# Optional launcher test flags (normally leave disabled)
GYMKIOSK_SKIP_ELECTRON=0
GYMKIOSK_TEST_MODE=0

# Optional desktop debugging
GYMKIOSK_DEVTOOLS=0
GYMKIOSK_DEVTOOLS_AUTO_OPEN=0
NODE_ENV=production

# Critical log email alerts
ALERT_EMAIL_ENABLED=1
ALERT_EMAIL_TO=rickyp3@me.com
ALERT_EMAIL_FROM=rickyp3@me.com

# Recommended: SendGrid SMTP
ALERT_SMTP_HOST=smtp.sendgrid.net
ALERT_SMTP_PORT=587
ALERT_SMTP_SECURE=0
ALERT_SMTP_USER=apikey
ALERT_SMTP_PASS=REPLACE_WITH_SENDGRID_API_KEY

# Alternative: service-based SMTP (Outlook/Hotmail/Gmail)
# ALERT_SMTP_SERVICE=hotmail
# ALERT_SMTP_USER=your@email.com
# ALERT_SMTP_PASS=YOUR_APP_PASSWORD

# Optional throttling (milliseconds)
ALERT_EMAIL_COOLDOWN_MS=600000
